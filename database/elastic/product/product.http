DELETE /product
PUT /product
{
  "mappings": {
    "properties": {
      "account_id": {
        "type": "keyword"
      },
      "search_content": {
        "type": "text"
      },
      "is_delete": {
        "type": "boolean"
      }
    }
  }
}

GET /_cat/indices/product?v

DELETE /product/_search
POST /product/_search
{
  "from": 0,
  "size": 20,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "account_id": "{{account_id}}"
          }
        },
        {
          "term": {
            "is_delete": false
          }
        }
      ],
      "should": [
        {
          "term": {
            "_id": {
              "value": "{{search_content}}",
              "boost": 100
            }
          }
        },
        {
          "match": {
            "search_content": {
              "query": "{{search_content}}",
              "operator": "and"
            }
          }
        }
      ],
      "minimum_should_match": 1
    }
  },
  "sort": [
    {
      "_score": {
        "order": "desc"
      }
    }
  ]
}

PUT _scripts/product_search
{
  "script": {
    "lang": "mustache",
    "source": {
      "from": 0,
      "size": 20,
      "track_total_hits": true,
      "query": {
        "bool": {
          "filter": [
            {
              "term": {
                "account_id": "{{account_id}}"
              }
            },
            {
              "term": {
                "is_delete": "{{is_delete}}"
              }
            }
          ],
          "should": [
            {
              "term": {
                "_id": {
                  "value": "{{search_content}}",
                  "boost": 100
                }
              }
            },
            {
              "match": {
                "search_content": {
                  "query": "{{search_content}}",
                  "operator": "and"
                }
              }
            }
          ],
          "minimum_should_match": 1
        }
      },
      "sort": [
        {
          "_score": {
            "order": "desc"
          }
        }
      ]
    }
  }
}

GET /product/_search
{
  "size": "100",
  "query": {
    "match_all": {}
  }
}

POST /product/_update_by_query
{
  "query": {
    "bool": {
      "must_not": [
        {
          "exists": {
            "field": "is_delete"
          }
        }
      ]
    }
  },
  "script": {
    "lang": "painless",
    "source": "ctx._source.is_delete = false"
  }
}