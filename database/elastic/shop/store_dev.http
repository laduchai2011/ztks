DELETE /store_dev
PUT store_dev
{
  "mappings": {
    "properties": {
      "depot_id": {
        "type": "keyword"
      },
      "search_content": {
        "type": "text"
      }
    }
  }
}

GET /_cat/indices/store_dev?v

DELETE /store_dev/_search
POST /store_dev/_search
{
  "from": 0,
  "size": 20,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "depot_id": "{{depot_id}}"
          }
        }
      ],
      "should": [
        {
          "term": {
            "_id": {
              "value": "{{search_content}}",
              "boost": 100
            }
          }
        },
        {
          "match": {
            "search_content": {
              "query": "{{search_content}}",
              "operator": "and"
            }
          }
        }
      ],
      "minimum_should_match": 1
    }
  },
  "sort": [
        {
            "_score": {
            "order": "desc"
            }
        }
    ]
}

PUT _scripts/store_dev_search
{
  "script": {
    "lang": "mustache",
    "source": {
      "from": 0,
      "size": 20,
      "track_total_hits": true,
      "query": {
        "bool": {
          "filter": [
            {
              "term": {
                "depot_id": "{{depot_id}}"
              }
            }
          ],
